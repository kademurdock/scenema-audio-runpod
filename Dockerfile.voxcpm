# VoxCPM2 (openbmb/VoxCPM2, Apache 2.0) serverless worker. Weights come from
# the RunPod model cache, pinned to one revision; nothing is downloaded at run time.
FROM runpod/pytorch:1.3.1-cu1281-torch271-ubuntu2204
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 HF_HUB_DISABLE_TELEMETRY=1
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv ffmpeg libsndfile1 && rm -rf /var/lib/apt/lists/*
# Same interpreter care as Dockerfile.auk-runpod: torch lives in the base `python`.
RUN python -c "import torch; assert torch.__version__.split('+')[0] == '2.7.1'" && python -m venv --system-site-packages /opt/voxcpm-env
ENV PATH="/opt/voxcpm-env/bin:${PATH}"
RUN python3 -m pip install --no-cache-dir --upgrade pip==25.3 setuptools==80.9.0 wheel==0.45.1
# voxcpm 2.0.3 asks for torch>=2.5 and torchcodec; torch stays the base's
# 2.7.1 (cu128) and torchcodec 0.5 is the release built for torch 2.7.
# transformers 4.57 keeps LlamaTokenizerFast as voxcpm imports it; it needs
# huggingface-hub<1, which gradio 6.10 (a voxcpm requirement) accepts.
RUN python3 -m pip install --no-cache-dir "voxcpm==2.0.3" "torch==2.7.1" "torchaudio==2.7.1" "torchcodec==0.5" \
        "transformers==4.57.6" "huggingface-hub==0.36.2" "gradio==6.10.0" \
        "runpod>=1.7,<2" "boto3>=1.35,<2" "soundfile>=0.12,<1" "requests>=2.32,<3" \
    && python3 -c "import torch; assert torch.__version__.split('+')[0] == '2.7.1', torch.__version__" \
    && python3 -m pip freeze | grep -iE "^(voxcpm|torch|torchaudio|torchcodec|transformers|huggingface.hub|gradio|numpy|wetext|runpod)==" \
    && rm -rf /root/.cache
WORKDIR /app
COPY voxcpm_contract.py voxcpm_handler.py /app/
# Build-time checks: the generate() keywords the handler passes exist in this
# voxcpm, and the text normalizer's English and Chinese grammars are in the image.
RUN python3 -c "import inspect; from voxcpm import VoxCPM; from voxcpm.model.voxcpm2 import VoxCPM2Model; import voxcpm_handler; \
p = inspect.signature(VoxCPM._generate).parameters; \
need = {'text','prompt_wav_path','prompt_text','reference_wav_path','cfg_value','inference_timesteps','normalize','denoise'}; \
assert need <= set(p), need - set(p); \
from voxcpm.utils.text_normalize import TextNormalizer; print(TextNormalizer().normalize('I have 3 apples at 5:30 pm.'))"
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ENV VOXCPM_MODEL_DIR=/runpod-volume/huggingface-cache/hub/models--openbmb--VoxCPM2/snapshots/7936080b41163874f38610f46f438e2c0757f9fd
ENTRYPOINT []
CMD ["python3", "-u", "/app/voxcpm_handler.py"]
