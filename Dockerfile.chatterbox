# Resemble AI Chatterbox (MIT) serverless worker: Turbo, original and
# Multilingual V3 in one image. Weights come from the RunPod model cache
# (ResembleAI/chatterbox-turbo and ResembleAI/chatterbox, each pinned to one
# revision); the code is resemble-ai/chatterbox at one commit.
FROM runpod/pytorch:1.3.1-cu1281-torch271-ubuntu2204
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 HF_HUB_DISABLE_TELEMETRY=1
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv git ffmpeg libsndfile1 && rm -rf /var/lib/apt/lists/*
# Same interpreter care as Dockerfile.voxcpm: torch lives in the base `python`.
RUN python -c "import sys, torch; print(sys.version); assert torch.__version__.split('+')[0] == '2.7.1'" && python -m venv --system-site-packages /opt/chatterbox-env
ENV PATH="/opt/chatterbox-env/bin:${PATH}"
RUN python3 -m pip install --no-cache-dir --upgrade pip==25.3 setuptools==80.9.0 wheel==0.45.1
# Upstream's pyproject pins, except torch: upstream asks for 2.6.0; this keeps
# the base's 2.7.1+cu128 (newer CUDA build for Ada and Blackwell cards).
# resemble-perth (the watermark upstream applies to every take) is pinned to
# the Perth commit upstream's "@master" pointed at on this date. Chatterbox
# itself goes in without dependencies so pip cannot swap torch.
RUN python3 -m pip install --no-cache-dir "torch==2.7.1" "torchaudio==2.7.1" \
        "numpy==1.26.4" "librosa==0.11.0" "s3tokenizer==0.3.0" "transformers==5.2.0" "tokenizers==0.22.2" "huggingface-hub==1.33.0" "diffusers==0.29.0" \
        "conformer==0.3.2" "safetensors==0.5.3" "spacy-pkuseg==1.0.1" "pykakasi==2.3.0" "pyloudnorm==0.1.1" \
        "omegaconf==2.3.0" "resemble-perth @ git+https://github.com/resemble-ai/Perth.git@ff1c8ac55a976971245cdd53c18d6131ca00d993" \
        "runpod==1.7.13" "boto3==1.40.70" "requests==2.32.5" "soundfile==0.13.1" \
    && python3 -m pip install --no-cache-dir --no-deps \
        "chatterbox-tts @ git+https://github.com/resemble-ai/chatterbox.git@ab55923c27757c90cfcc407baa57dc25a7d25217" \
    && python3 -c "import torch; assert torch.__version__.split('+')[0] == '2.7.1', torch.__version__" \
    && (python3 -m pip check || true) \
    && python3 -m pip freeze | grep -iE "^(chatterbox.tts|torch|torchaudio|transformers|tokenizers|huggingface.hub|diffusers|s3tokenizer|resemble.perth|librosa|numpy|runpod)" \
    && rm -rf /root/.cache
# The multilingual tokenizer starts spacy-pkuseg's Chinese segmenter at load,
# which fetches its model (spacy_ontonotes, from the spacy-pkuseg 1.0.1
# release) into ~/.pkuseg on first use. Fetch it now so the worker never does.
RUN python3 -c "from spacy_pkuseg import pkuseg; print(pkuseg().cut('今天天气真不错'))" && ls -la /root/.pkuseg
WORKDIR /app
COPY chatterbox_contract.py chatterbox_handler.py test_chatterbox_handler.py /app/
# Build-time checks: the unit tests (with the contract's language list checked
# against upstream's), every upstream module the handler loads imports, the
# keywords the handler passes exist in this chatterbox, and Perth's bundled
# watermark model loads (upstream would crash on a missing watermarker).
RUN CHATTERBOX_UPSTREAM=1 python3 -m unittest -v test_chatterbox_handler.py \
    && python3 -c "import inspect, chatterbox_handler, perth; \
from chatterbox.tts_turbo import ChatterboxTurboTTS; from chatterbox.tts import ChatterboxTTS; \
from chatterbox.mtl_tts import ChatterboxMultilingualTTS; import chatterbox.models.tokenizers.tokenizer as tok; \
assert callable(tok.hf_hub_download); \
names = lambda f: set(inspect.signature(f).parameters); \
assert {'text', 'temperature'} <= names(ChatterboxTurboTTS.generate); \
assert {'text', 'exaggeration', 'cfg_weight', 'temperature'} <= names(ChatterboxTTS.generate); \
assert {'text', 'language_id', 'exaggeration', 'cfg_weight', 'temperature'} <= names(ChatterboxMultilingualTTS.generate); \
assert {'wav_fpath', 'exaggeration'} <= names(ChatterboxTTS.prepare_conditionals) & names(ChatterboxMultilingualTTS.prepare_conditionals); \
assert {'ckpt_dir', 'device', 't3_model'} <= names(ChatterboxMultilingualTTS.from_local); \
assert perth.PerthImplicitWatermarker is not None; w = perth.PerthImplicitWatermarker(); \
import numpy as np; out = w.apply_watermark(np.zeros(24000, dtype=np.float32) + 0.01, sample_rate=24000); \
print('perth ok', out.shape)"
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ENTRYPOINT []
CMD ["python3", "-u", "/app/chatterbox_handler.py"]
