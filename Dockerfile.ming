# Ming-3.0-tts-tiny (inclusionAI, MIT; 7.9B MoE, 1.3B active) serverless worker.
# Weights come from the RunPod model cache, pinned to one revision; the code
# is inclusionAI/Ming-3.0-tts at one commit. Nothing is downloaded at run time.
FROM runpod/pytorch:1.3.1-cu1281-torch271-ubuntu2204
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 HF_HUB_DISABLE_TELEMETRY=1
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv git ffmpeg libsndfile1 && rm -rf /var/lib/apt/lists/*
# Same interpreter care as Dockerfile.voxcpm: torch lives in the base `python`.
RUN python -c "import sys, torch; print(sys.version); assert torch.__version__.split('+')[0] == '2.7.1'" && python -m venv --system-site-packages /opt/ming-env
ENV PATH="/opt/ming-env/bin:${PATH}"
RUN python3 -m pip install --no-cache-dir --upgrade pip==25.3 setuptools==80.9.0 wheel==0.45.1
# Upstream's requirements-tiny.txt pins, except torch: Ming tests 2.7.1+cu118;
# this keeps the base's 2.7.1+cu128 (same release, newer CUDA build for Ada and
# Blackwell cards). transformers must be exactly 4.46.3 (the loader checks it).
# pynini is the optional FST text normalizer Ming uses for numbers and dates.
RUN python3 -m pip install --no-cache-dir "torch==2.7.1" "torchaudio==2.7.1" "triton==3.3.1" \
        "transformers==4.46.3" "tokenizers==0.20.3" "safetensors==0.8.0" "accelerate==1.14.0" \
        "huggingface-hub==0.36.2" "packaging==26.2" "numpy==1.26.4" "scipy==1.15.3" "soundfile==0.14.0" \
        "onnxruntime==1.23.2" "einops==0.8.2" "einx==0.4.3" "loguru==0.7.3" "x-transformers==2.7.4" \
        "fla-core==0.4.2" "inflect==7.5.0" "pynini==2.1.6" \
        "runpod==1.7.13" "boto3==1.40.70" "requests==2.32.5" \
    && python3 -c "import torch; assert torch.__version__.split('+')[0] == '2.7.1', torch.__version__" \
    && python3 -m pip freeze | grep -iE "^(torch|torchaudio|triton|transformers|tokenizers|fla.core|pynini|numpy|onnxruntime|x.transformers|runpod|boto3)==" \
    && rm -rf /root/.cache
WORKDIR /app
RUN git clone https://github.com/inclusionAI/Ming-3.0-tts /app/upstream && cd /app/upstream \
    && git checkout a39b80660bdc5a4394d5e1d41af6dbfd9c443a54 && rm -rf .git figures data/wavs
ENV PYTHONPATH=/app/upstream:/app
COPY ming_contract.py ming_handler.py test_ming_handler.py /app/
# Build-time checks: the contract agrees with Ming's own task resolver and tag
# list (MING_UPSTREAM tests), the real modules import, and the FST normalizer
# reads numbers and times in this image.
RUN MING_UPSTREAM=/app/upstream python3 -m unittest -v test_ming_handler.py \
    && python3 -c "import ming_handler, onnxruntime, x_transformers, fla; \
from ming_tiny.api import MingTinyTTS; from ming_tiny.inference import MingTinyEngine; \
from frontend.talker_tn.talker_tn import TalkerTN; print(TalkerTN().normalize('I have 3 apples at 5:30 pm.', language='en'))"
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ENV MING_MODEL_DIR=/runpod-volume/huggingface-cache/hub/models--inclusionAI--Ming-3.0-tts-tiny/snapshots/4715ef5a2f02901f75687d538b6920fd0dd11e6b
ENTRYPOINT []
CMD ["python3", "-u", "/app/ming_handler.py"]
